// --- JADRO SYSTÉMU (FUNKCIE) ---

function startQuest(id: string) {
    if (quests[id] && !activeQuests[id]) {
        activeQuests[id] = quests[id]
        questProgress[id] = 0
        player.say(`§b§l[NOVÁ ÚLOHA] §e${quests[id].name}`)
        player.say(`§7Cieľ: ${quests[id].desc}`)
        player.runChatCommand(`scoreboard players set "${quests[id].name}" Quests 0`)
    }
}

function updateQuest(id: string, val: number) {
    if (activeQuests[id]) {
        questProgress[id] += val
        let q = activeQuests[id]

        // --- AUTOMATICKÝ REFRESH PROGRESU V CHATE ---
        player.say(`§6[PROGRES] §f${q.name}: §e${questProgress[id]}/${q.amount}`)

        player.runChatCommand(`title @s actionbar §6${q.name}: §f${questProgress[id]}/${q.amount}`)
        player.runChatCommand(`scoreboard players set "${q.name}" Quests ${questProgress[id]}`)

        if (questProgress[id] >= q.amount) {
            // --- ODMENY (PREDMETY + XP) ---
            player.runChatCommand(q.reward)
            player.runChatCommand(`xp ${q.mc_xp}l @s`)
            addRPGXP(q.rpg_xp)

            player.runChatCommand("playsound random.levelup @a")
            player.say(`§a§l[!] QUEST DOKONČENÝ: §f${q.name}`)
            player.say(`§7Odmena: Predmety + ${q.mc_xp} Levelov + ${q.rpg_xp} RPG XP`)

            player.runChatCommand(`scoreboard players reset "${q.name}" Quests`)
            delete activeQuests[id]
            if (q.next != "") startQuest(q.next)
        }
    }
}

function addRPGXP(amount: number) {
    playerXP += amount
    if (playerXP >= playerLevel * 300) {
        playerLevel++
        playerXP = 0
        player.runChatCommand(`title @s title "§d§lRPG LEVEL UP!"`)
        player.say("§d§l⭐ Tvoj RPG level sa zvýšil na " + playerLevel)
    }
    player.runChatCommand(`scoreboard players set "RPG_Level" Stats ${playerLevel}`)
}

// --- DETEKCIA EVENTOV ---

