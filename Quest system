//  QUEST SYSTEM PRO  

let activeQuests: any = {}
let completedQuests: string[] = []
let questProgress: any = {}

const quests: any = {
    quest1: { id: "quest1", name: "Zber dreva", description: "Získaj 2 kusov dreva", type: "collect", amount: 2, rewardItem: Item.Diamond, rewardCount: 3 },
    quest2: { id: "quest2", name: "Staviteľ", description: "Poloz 2 dreva", type: "build", amount: 2, rewardItem: Item.IronIngot, rewardCount: 5 },
    quest3: { id: "quest3", name: "Prieskumník", description: "Prejdi 10 blokov", type: "travel", amount: 10, rewardItem: Item.GoldIngot, rewardCount: 4 },
    quest4: { id: "quest4", name: "Lovec", description: "Zabi 2 zombie", type: "combat", amount: 2, rewardItem: Item.Emerald, rewardCount: 5 },
    quest5: { id: "quest5", name: "Baník", description: "Vyťaž 5 kameňov", type: "mine", amount: 5, rewardItem: Item.GoldIngot, rewardCount: 2 },
    quest6: { id: "quest6", name: "Lukostrelec", description: "Zabi 1 kostlivca", type: "hunt", amount: 1, rewardItem: Item.Arrow, rewardCount: 32 }
}

// Reset and setup Scoreboard
player.runChatCommand("scoreboard objectives add Quests dummy \"§6§lQUESTY\"")
player.runChatCommand("scoreboard objectives setdisplay sidebar Quests")

function startQuest(id: string) {
    if (quests[id] && !activeQuests[id]) {
        activeQuests[id] = quests[id]
        questProgress[id] = 0
        player.say("§b[!] Quest: §e" + quests[id].name)
        player.say("§7" + quests[id].description)

        player.runChatCommand("playsound note.pling @s")
        updateScoreboard(quests[id].name, 0)
    }
}

function updateQuest(type: string, value: number) {
    let keys = Object.keys(activeQuests)
    for (let id of keys) {
        if (activeQuests[id].type === type) {
            questProgress[id] += value
            let q = activeQuests[id]

            // Vypísanie progresu do chatu pri každej zmene
            player.say("§7> " + q.name + ": §f" + questProgress[id] + "/" + q.amount)

            updateScoreboard(q.name, questProgress[id])

            if (questProgress[id] >= q.amount) {
                completeQuest(id)
            }
        }
    }
}

function updateScoreboard(objName: string, val: number) {
    player.runChatCommand(`scoreboard players set "${objName}" Quests ${val}`)
}

function completeQuest(id: string) {
    let q = activeQuests[id]
    mobs.give(mobs.target(NEAREST_PLAYER), q.rewardItem, q.rewardCount)

    player.runChatCommand("playsound random.levelup @s")
    player.runChatCommand("particle minecraft:totem_particle ~ ~1 ~")

    player.say("§a§l[✔] HOTOVO: §f" + q.name)
    player.runChatCommand(`scoreboard players reset "${q.name}" Quests`)

    completedQuests.push(id)
    delete activeQuests[id]
    delete questProgress[id]
}

// Eventy
blocks.onBlockPlaced(LOG_OAK, function () { updateQuest("build", 1) })
blocks.onBlockBroken(LOG_OAK, function () { updateQuest("collect", 1) })
blocks.onBlockBroken(COBBLESTONE, function () { updateQuest("mine", 1) })
mobs.onMobKilled(mobs.monster(ZOMBIE), function () { updateQuest("combat", 1) })
mobs.onMobKilled(mobs.monster(SKELETON), function () { updateQuest("hunt", 1) })

let lastX = 0, lastZ = 0, first = true
loops.forever(function () {
    let pos = player.position()
    let x = pos.getValue(Axis.X)
    let z = pos.getValue(Axis.Z)
    if (!first) {
        let dist = Math.floor(Math.abs(x - lastX) + Math.abs(z - lastZ))
        if (dist > 0) updateQuest("travel", dist)
    }
    lastX = x; lastZ = z; first = false
    loops.pause(2000)
})

// Komandy
player.onChat("help", function () {
    player.say("§6--- [ DOSTUPNÉ QUESTY ] ---")
    player.say("§e.quest1 §7- Zber dreva")
    player.say("§e.quest2 §7- Staviteľ")
    player.say("§e.quest3 §7- Prieskumník")
    player.say("§e.quest4 §7- Lovec")
    player.say("§e.quest5 §7- Baník")
    player.say("§e.quest6 §7- Lukostrelec")
    player.say("§fNapíš §e.active §fpre tvoj progres.")
})

player.onChat("active", function () {
    let keys = Object.keys(activeQuests)
    if (keys.length === 0) {
        player.say("§7Nemáš žiadne aktívne questy.")
    } else {
        player.say("§6--- [ AKTÍVNE ] ---")
        for (let id of keys) {
            player.say(`§e${activeQuests[id].name}: §f${questProgress[id]}/${activeQuests[id].amount}`)
        }
    }
})

player.onChat("quest1", () => startQuest("quest1"))
player.onChat("quest2", () => startQuest("quest2"))
player.onChat("quest3", () => startQuest("quest3"))
player.onChat("quest4", () => startQuest("quest4"))
player.onChat("quest5", () => startQuest("quest5"))
player.onChat("quest6", () => startQuest("quest6"))

player.say("§6Quest System Active! §7Použi §e.help")
