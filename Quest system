mobs.onMobKilled(mobs.monster(SKELETON), () => updateQuest("skelet", 1))
mobs.onMobKilled(SQUID, () => updateQuest("rybar", 1))
mobs.onMobKilled(WOLF, () => updateQuest("vlk", 1))

// --- HLAVNÝ BEH (LOOP) ---

loops.forever(function () {
    let currentPos = player.position()
    let x = Math.floor(currentPos.getValue(Axis.X))
    let z = Math.floor(currentPos.getValue(Axis.Z))

    // Regenerácia many
    if (playerMana < 100) playerMana += 5

    // Výpočet vzdialenosti (Prieskumník)
    if (!firstRun) {
        let dist = Math.abs(x - lastX) + Math.abs(z - lastZ)
        if (dist > 0) updateQuest("prieskum", dist)
    }

    lastX = x
    lastZ = z
    firstRun = false
    loops.pause(2000)
})

