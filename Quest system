blocks.onBlockBroken(IRON_ORE, () => updateQuest("banik", 1))
blocks.onBlockBroken(GOLD_ORE, () => updateQuest("zlato", 1))
blocks.onBlockBroken(DIAMOND_ORE, () => updateQuest("diamant", 1))
blocks.onBlockBroken(SAND, () => updateQuest("sklar", 1))
blocks.onBlockPlaced(PLANKS_OAK, () => updateQuest("stavba", 1))

// Farmár Fix: Interakcia s predmetmi
player.onItemInteracted(SEEDS, () => { if (activeQuests["farmar"]) updateQuest("farmar", 1) })
player.onItemInteracted(CARROTS, () => { if (activeQuests["farmar"]) updateQuest("farmar", 1) })
